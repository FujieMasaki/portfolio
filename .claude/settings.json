{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm lint)",
      "Bash(pnpm type-check)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch origin *)",
      "Bash(git merge-base *)",
      "Bash(git rev-parse *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(node scripts/codex-final-check.mjs *)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Bash(gh pr merge *)",
      "Bash(git * --output*)",
      "Bash(git fetch *--upload-pack*)",
      "Bash(git fetch *--exec*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git add -f*)",
      "Bash(git add * -f*)",
      "Bash(git add --force*)",
      "Bash(git add * --force*)",
      "Bash(git switch -f*)",
      "Bash(git switch * -f*)",
      "Bash(git switch --force*)",
      "Bash(git switch * --force*)",
      "Bash(git switch *--discard-changes*)",
      "Bash(git switch -C*)",
      "Bash(git switch * -C*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push -uf*)",
      "Bash(git push -fu*)",
      "Bash(git push *+*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push *--prune*)",
      "Bash(git push *:main*)",
      "Bash(git push *:heads/*)",
      "Bash(git push *:refs/*)",
      "Bash(git push *:tags/*)",
      "Bash(git push *:remotes/*)"
    ]
  }
}
